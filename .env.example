# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=1234567890:AABBCCDDEEFFaabbccddeeff1234567890

# Public base URL of your server (used to generate webhook URLs for owners)
BASE_URL=https://sos.your-domain.com

# Server settings
HOST=0.0.0.0
PORT=8000

# Path to SQLite database file
DB_PATH=data/sos.db

# Telegram chat_id of the bot administrator.
# If set, new registrations require admin approval before the user can use the bot.
# The admin also gets /admin command to manage owners.
# Leave empty (or remove) to allow instant self-registration.
# ADMIN_CHAT_ID=123456789

# Optional: MAX messenger bot token (from @MasterBot in MAX).
# If set, the service also runs a MAX bot so owners and subscribers can use
# MAX independently of Telegram. Leave empty to run Telegram-only.
# MAX_BOT_TOKEN=your-max-bot-token

# Optional: automatic database backups sent to the admin (requires ADMIN_CHAT_ID).
# Interval in hours; 0 or unset disables auto-backup. Use /backup for a manual one.
# BACKUP_INTERVAL_HOURS=24

# Optional: if set, backup archives are encrypted (.tar.gz.enc, AES-256-GCM).
# Keep this passphrase safe — without it an encrypted backup cannot be restored.
# BACKUP_PASSPHRASE=your-strong-passphrase
