# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=1234567890:AABBCCDDEEFFaabbccddeeff1234567890

# Public base URL of your server (used to generate webhook URLs for owners)
BASE_URL=https://sos.your-domain.com

# Server settings
HOST=0.0.0.0
PORT=8000

# Path to SQLite database file
DB_PATH=data/sos.db

# Telegram chat_id of the bot administrator.
# If set, new registrations require admin approval before the user can use the bot.
# The admin also gets /admin command to manage owners.
# Leave empty (or remove) to allow instant self-registration.
# ADMIN_CHAT_ID=123456789
