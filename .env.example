# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=1234567890:AABBCCDDEEFFaabbccddeeff1234567890

# Your Telegram chat ID (get it from @userinfobot)
ADMIN_CHAT_ID=123456789

# Your name that will appear in SOS messages
OWNER_NAME=Алиса

# Custom SOS message (optional)
SOS_MESSAGE=🆘 ТРЕВОГА! Мне нужна помощь! Это сообщение отправлено через голосовую команду.

# Server settings
HOST=0.0.0.0
PORT=8000

# Secret token to verify requests from Yandex Alice (optional but recommended)
ALICE_SECRET=your_secret_token_here

# File to store contacts
CONTACTS_FILE=contacts.json
